        android:translateX="-3" android:translateY="1">
    <!-- Face -->
    <path android:pathData="M50,40 a17,17 0 1,1 0,34 a17,17 0 1,1 0,-34"
        android:strokeColor="#FFFFFFFF" android:strokeWidth="5" />
    <!-- Hands -->
    <path android:pathData="M50,48 L50,57 L56,61"
        android:strokeColor="#FFFFFFFF" android:strokeWidth="4.5"
        android:strokeLineCap="round" android:strokeLineJoin="round" />
    <!-- Bells: filled domes, slightly apart from the face -->
    <path android:pathData="M30.5,44.5 A10,10 0 0,1 43.5,31.5 Z" android:fillColor="#FFFFFFFF" />
    <path android:pathData="M56.5,31.5 A10,10 0 0,1 69.5,44.5 Z" android:fillColor="#FFFFFFFF" />
    <!-- Legs -->
    <path android:pathData="M39,72 L35.5,76.5 M61,72 L64.5,76.5"
        android:strokeColor="#FFFFFFFF" android:strokeWidth="4.5" android:strokeLineCap="round" />
    <!-- The wisp -->
    <path android:pathData="M73,46 m-2.8,0 a2.8,2.8 0 1,0 5.6,0 a2.8,2.8 0 1,0 -5.6,0"
        android:fillColor="#FFFFFFFF" android:fillAlpha="0.85" />
    <path android:pathData="M78.5,39.5 m-2.1,0 a2.1,2.1 0 1,0 4.2,0 a2.1,2.1 0 1,0 -4.2,0"
        android:fillColor="#FFFFFFFF" android:fillAlpha="0.55" />
    <path android:pathData="M83,33.5 m-1.5,0 a1.5,1.5 0 1,0 3,0 a1.5,1.5 0 1,0 -3,0"
        android:fillColor="#FFFFFFFF" android:fillAlpha="0.3" />
    </group>
